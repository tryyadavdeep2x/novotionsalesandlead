datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model UserAdmin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model AccessKey {
  id        String   @id @default(uuid())
  key       String   @unique
  role      String   // "LEAD_TEAM" or "SALES_TEAM"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Lead {
  id               String             @id @default(uuid())
  candidateName    String             // Lead / Company Name
  phoneNumber      String
  email            String
  visaStatus       String             @default("Citizen")
  linkedinUrl      String             @default("")
  chatBrief        String             @default("") // Quick Notes
  jobProfile       String             @default("General Opportunity")
  createdByName    String             @default("System")
  isCold           Boolean            @default(false)
  temperature      String             @default("Warm") // "Cold" | "Warm" | "Hot"
  stage            String             @default("New")  // "New" | "Contacted" | "Proposal Sent" | "Won" | "Lost"
  dealValueUsd     Float              @default(0.0)    // Strictly restricted to Sales only
  currentStatus    String             @default("Unconverted (Active)") // "Converted" | "Unconverted (Active)" | "Lost" | "No Response"
  salesRepName     String?
  salesRepId       String?
  nextFollowUpDate DateTime?
  createdAt        DateTime           @default(now())
  statusUpdatedAt  DateTime           @default(now()) @updatedAt
  interactions     SalesInteraction[]
}

model SalesInteraction {
  id                String   @id @default(uuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  salesRepName      String
  status            String   // "Interested", "Not Interested", "Follow-Up Required", "Converted", "No Response", "Lost"
  candidateFeedback String
  updatedAt         DateTime @default(now()) @updatedAt
}

model SupportTicket {
  id             String    @id @default(uuid())
  clientName     String    // Client / Company Name
  contactPerson  String    // Primary Contact Person
  email          String
  phone          String
  accountStatus  String    @default("Active") // "Onboarding" | "Active" | "In Support" | "Renewal Due"
  ticketSubject  String    // Service Request Subject
  description    String    // Description / Notes
  priority       String    @default("Medium") // "Low" | "Medium" | "High"
  assignedAgent  String    @default("Support Agent")
  status         String    @default("Open")   // "Open" | "In Progress" | "Resolved" | "Closed"
  resolutionDate DateTime?
  activityLogs   String    @default("Ticket registered")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}
